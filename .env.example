# Supabase → Project Settings → API
# Project URL only, for example https://your-project.supabase.co
# Leave off /rest/v1. That path is the data API, not the sign-in host.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Supabase → Project Settings → API → secret key.
# Used to store the Gmail token. The browser cannot read that table.
SUPABASE_SECRET_KEY=

# Same Google OAuth client you paste into Supabase Auth → Google.
# Needed when the short-lived Gmail token expires.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Without this, mail and DMs are still read with the rules reader.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional. Without this, reply drafts stay on the rules writer. Nothing is sent.
XAI_API_KEY=
XAI_MODEL=grok-4

# Meta app → Instagram → API setup with Instagram login.
# Redirect URI: https://brand-deal-inbox.vercel.app/auth/instagram/callback
# Leave INSTAGRAM_LIVE unset until sandbox/instagram passes in Postman
# and Meta approves instagram_business_manage_messages.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_LIVE=

# Optional published prices. If both are empty, the desk does not invent a fee.
MODASH_API_KEY=
HYPEAUDITOR_API_ID=
HYPEAUDITOR_API_TOKEN=

# X, WhatsApp, Outlook, and Messenger are paused. Their routes redirect to /connect.
