# Supabase → Project Settings → API
# Project URL only, for example https://your-project.supabase.co
# Leave off /rest/v1. That path is the data API, not the sign-in host.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Supabase → Project Settings → API → secret key.
# Used to store the Gmail token. The browser cannot read that table.
SUPABASE_SECRET_KEY=

# Same Google OAuth client you paste into Supabase Auth → Google.
# Needed when the short-lived Gmail token expires.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Reads mail and DMs, rewrites drafts, and reviews contracts.
# Without it, the rules reader, the template writer, and the clause scanner still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Razorpay → Account & Settings → API keys. Brands pay invoices online, the creator's
# share settles to their Route linked account, and Counter keeps its fee.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → https://<your-domain>/api/razorpay/webhook with events:
# payment_link.paid, payment_link.cancelled, payment_link.expired, subscription.*
RAZORPAY_WEBHOOK_SECRET=
# Razorpay → Subscriptions → Plans: ₹24,000 monthly. Leave empty to hide the agency plan.
RAZORPAY_AGENCY_PLAN_ID=

# Any long random string. Vercel Cron sends it to /api/cron/autopilot,
# which syncs inboxes and runs autopilot for creators who switched it on.
CRON_SECRET=

# Meta app → Instagram → API setup with Instagram login.
# Redirect URI: https://brand-deal-inbox.vercel.app/auth/instagram/callback
# The app calls the live Instagram API. While the Meta app is in Development mode,
# only accounts added as Instagram testers can connect. Set INSTAGRAM_LIVE=true once
# Meta App Review approves instagram_business_manage_messages (it only changes the UI copy).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_LIVE=

# Optional published prices. If both are empty, the desk does not invent a fee.
MODASH_API_KEY=
HYPEAUDITOR_API_ID=
HYPEAUDITOR_API_TOKEN=

