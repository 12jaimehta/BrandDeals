# Supabase → Project Settings → API
# Project URL only, for example https://your-project.supabase.co
# Leave off /rest/v1. That path is the data API, not the sign-in host.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Supabase → Project Settings → API → secret key.
# Used to store the Gmail token. The browser cannot read that table.
SUPABASE_SECRET_KEY=

# Same Google OAuth client you paste into Supabase Auth → Google.
# Needed when the short-lived Gmail token expires.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Without this, mail and DMs are still read with the rules reader.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional. Without this, reply drafts stay on the rules writer. Nothing is sent.
XAI_API_KEY=
XAI_MODEL=grok-4

# Meta app → Instagram → API setup with Instagram login.
# Redirect URI: http://localhost:3000/auth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Optional — Outlook (Microsoft identity platform, Mail.Read + Mail.Send).
# Redirect URI: http://localhost:3000/auth/outlook/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Optional — X (developer portal, OAuth 2.0 with DM read/write).
# Redirect URI: http://localhost:3000/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional — WhatsApp Business (Meta app with the WhatsApp product).
# Redirect URI: http://localhost:3000/auth/whatsapp/callback
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=

# Optional — Messenger (Meta app with Facebook Login and the Messenger product).
# Facebook rejects http. Use the https address you open in the browser.
# Redirect URI: https://your-host/auth/messenger/callback
MESSENGER_APP_ID=
MESSENGER_APP_SECRET=
